<div class="login-wrapper">
  <div class="login-container">
    
    <!-- Aproveitando a mesma estrutura de flash messages -->
    <% if flash[:notice] %>
      <div class="notice-message" id="mensagem-notice" style="color: green; text-align: center; margin-bottom: 15px;">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <h1>Recuperar Senha</h1>
    <p style="text-align: center; margin-bottom: 25px; font-size: 14px; color: #666;">
      Digite seu e-mail cadastrado e enviaremos instruções para redefinir sua senha.
    </p>
    
    <%= form_with url: recuperacao_senhas_path, local: true do |form| %>
      <div class="input-group">
 
        <%= image_tag "user.png", alt: "Ícone E-mail" %>
        <%= form.email_field :email, placeholder: "Seu E-mail", required: true %>
      </div>
      
      <%= form.submit "Enviar Link", class: "login-button" %>
    <% end %>

    <div style="text-align: center; margin-top: 20px;">
      <%= link_to "Voltar para o Login", login_path, class: "forgot-password-link" %>
    </div>

  </div>
</div>