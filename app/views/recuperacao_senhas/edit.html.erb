<div class="login-wrapper">
  <div class="login-container">
    
    <% if flash.now[:erro] %>
      <div class="error-message" id="mensagem-erro">
        <%= flash.now[:erro] %>
      </div>
    <% end %>

    <h1>Nova Senha</h1>
    <p style="text-align: center; margin-bottom: 25px; font-size: 14px; color: #666;">
      Crie uma nova senha para a sua conta.
    </p>
    
    <%= form_with model: @bibliotecario, url: recuperacao_senha_path(params[:id]), method: :patch, local: true do |form| %>
      
      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
    
        <%= form.password_field :password, placeholder: "Nova Senha", required: true %>
      </div>

      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :password_confirmation, placeholder: "Confirme a Nova Senha", required: true %>
      </div>
      
      <%= form.submit "Salvar Nova Senha", class: "login-button" %>
    <% end %>

  </div>
</div>