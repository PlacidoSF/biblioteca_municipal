<div class="content">

  <div class="action-bar" style="justify-content: flex-start;">
    <%= link_to "VOLTAR", bibliotecarios_path, class: "btn-menu", style: "color: #000; background: #e9e5e5; border-radius: 5px;" %>
  </div>

  <div class="form-container">
    <h1 class="page-title">Novo Bibliotecário</h1>
    <p class="page-subtitle">Preencha os dados para cadastrar um novo usuário no sistema.</p>

    <% if @bibliotecario.errors.any? %>
      <div class="error-message">
        <ul style="list-style-type: none; padding: 0; margin: 0;">
          <% @bibliotecario.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @bibliotecario, local: true do |form| %>
      
      <div class="input-grid">
        <%= form.text_field :nome, placeholder: "Nome Completo", required: true, class: "input-field" %>
        <%= form.email_field :email, placeholder: "E-mail Institucional", required: true, class: "input-field" %>
        <%= form.password_field :password, placeholder: "Senha Provisória", required: true, class: "input-field" %>
        <%= form.password_field :password_confirmation, placeholder: "Confirme a Senha", required: true, class: "input-field" %>
      </div>

      <%= form.submit "CADASTRAR", class: "btn-confirmar" %>
      
    <% end %>
  </div>
</div>