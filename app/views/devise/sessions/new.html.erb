<% flash.delete(:notice) %>
<div class="login-wrapper">
  <div class="login-container">
    
    <% if alert || notice %>
      <div class="error-message" id="mensagem-erro">
        <%= alert || notice %>
      </div>

      <script>
        setTimeout(function() {
          const mensagem = document.getElementById('mensagem-erro');
          if (mensagem) {
            mensagem.style.transition = 'opacity 0.5s ease';
            mensagem.style.opacity = '0';
            
            setTimeout(function() {
              mensagem.remove();
            }, 500); 
          }
        }, 2000);
      </script>
    <% end %>

    <h1>Log in</h1>
    
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |form| %>
      <div class="input-group">
        <%= image_tag "user.png", alt: "Ícone Usuário" %>
        <%= form.email_field :email, placeholder: "Usuário", autofocus: true, required: true %>
      </div>
      
      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :password, placeholder: "Senha", required: true %>
      </div>
      
      <%= form.submit "Log in", class: "login-button" %>
    <% end %>

   <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "forgot-password-link" %>

  </div>
</div>