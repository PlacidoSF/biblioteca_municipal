<div class="login-wrapper">
  <div class="login-container">
    
    <% if resource.errors.any? || alert || flash.now[:erro] %>
      <div class="error-message" id="mensagem-erro">
        <% if resource.errors.any? %>
          <ul style="list-style-type: none; padding: 0; margin: 0;">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        <% else %>
          <%= alert || flash.now[:erro] %>
        <% end %>
      </div>

      <script>
        setTimeout(function() {
          const mensagem = document.getElementById('mensagem-erro');
          if (mensagem) {
            mensagem.style.transition = 'opacity 0.5s ease';
            mensagem.style.opacity = '0';
            setTimeout(function() { mensagem.remove(); }, 500); 
          }
        }, 2000);
      </script>
    <% end %>

    <h1>Nova Senha</h1>
    <p style="text-align: center; margin-bottom: 20px; color: #666; font-size: 14px;">
      Por segurança, defina uma senha definitiva antes de acessar o sistema.
    </p>
    
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, data: { turbo: false }) do |form| %>
      
      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :password, autocomplete: "new-password", placeholder: "Nova Senha", required: true %>
      </div>
      
      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirme a Nova Senha", required: true %>
      </div>

      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :current_password, autocomplete: "current-password", placeholder: "Senha Atual (Provisória)", required: true %>
      </div>
      
      <%= form.submit "Salvar e Entrar", class: "login-button" %>
    <% end %>

  </div>
</div>