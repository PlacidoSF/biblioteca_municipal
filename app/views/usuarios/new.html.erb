<div class="content">
  <div class="action-bar" style="justify-content: flex-start;">
    <%= link_to "VOLTAR", usuarios_path, class: "btn-menu", style: "color: #000; background: #e9e5e5; border-radius: 5px;" %>
  </div>

  <div class="form-container">
    <h1 class="page-title">Novo Usuário</h1>
    <p class="page-subtitle">Cadastre um novo leitor. A senha de empréstimo será gerada automaticamente.</p>
    
    <% if @usuario.errors.any? %>
      <div class="error-message">
        <ul style="list-style-type: none; padding: 0; margin: 0;">
          <% @usuario.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @usuario, local: true do |form| %>
      <div class="input-grid">
        <%= form.text_field :nome, placeholder: "Nome Completo", required: true, class: "input-field" %>
        
        <%= form.text_field :cpf, placeholder: "CPF (Apenas números)", required: true, class: "input-field" %>
        
        <%= form.text_field :telefone, placeholder: "Telefone (com DDD)", required: true, class: "input-field" %>
        
        <%= form.email_field :email, placeholder: "E-mail", required: true, class: "input-field" %>
      </div>

      <%= form.submit "CADASTRAR", class: "btn-confirmar" %>
    <% end %>
  </div>
</div>