<div class="content">
  <div class="action-bar" style="display: flex; justify-content: flex-end; align-items: center;">
    <%= link_to "+ Nova Categoria", new_categoria_path, class: "btn-novo" %>
  </div>

  <div class="table-header" style="display: grid; grid-template-columns: 1fr 100px; margin-bottom: 10px;">
    <div class="col-nome" style="text-align: left;">Nome da Categoria</div>
    <div class="col-acoes" style="text-align: center;">Ações</div>
  </div>

  <% @categorias.each do |categoria| %>
    <div class="row" style="display: grid; grid-template-columns: 1fr 100px; align-items: center; margin-bottom: 10px;">
      <div class="col-nome" style="text-align: left;"><%= categoria.nome %></div>
      
      
      <div class="col-acoes" style="display: flex; justify-content: center; gap: 10px;">  
        <%= link_to edit_categoria_path(categoria), class: "btn-action btn-editar", title: "Editar" do %>
          <%= image_tag "alterar.png", alt: "Editar", width: 20 %>
        <% end %>

        <button class="btn-action btn-excluir" title="Excluir Categoria" onclick="abrirModalExcluir('<%= categoria.id %>')">
          <%= image_tag "excluir.png", alt: "Excluir", width: 20 %>
        </button>
        
        <div style="display: none;">
          <%= button_to "Deletar", categoria_path(categoria), method: :delete, id: "btn_real_delete_#{categoria.id}" %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Modal de Exclusão Padrão Escuro -->
  <div id="modalExcluir" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); z-index: 1000; align-items: center; justify-content: center;">
      <div style="background: #1e1e1e; color: #ffffff; padding: 40px 30px; border-radius: 25px; width: 350px; position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.8); text-align: center;">
          
          <button onclick="fecharModalExcluir()" style="position: absolute; top: 15px; right: 20px; background: transparent; border: none; color: #888; font-size: 20px; cursor: pointer; transition: color 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#888'">✖</button>
          
          <h2 style="margin-top: 0; margin-bottom: 20px; font-size: 22px; font-weight: bold;">Atenção!</h2>
          <p style="margin-bottom: 30px; color: #ccc; font-size: 14px;">Tem certeza que deseja excluir esta categoria? Esta ação não pode ser desfeita.</p>
          
          <button onclick="confirmarExclusao()" style="width: 100%; padding: 15px; background: #cc0000; color: white; border: none; border-radius: 25px; font-size: 16px; font-weight: bold; cursor: pointer;">Sim, Excluir</button>
      </div>
  </div>

</div> 

<script>
    let idParaExcluir = null;

    function abrirModalExcluir(id) {
        idParaExcluir = id;
        document.getElementById('modalExcluir').style.display = 'flex';
    }
    
    function fecharModalExcluir() {
        document.getElementById('modalExcluir').style.display = 'none';
        idParaExcluir = null;
    }

    function confirmarExclusao() {
        if (idParaExcluir) {
            document.getElementById('btn_real_delete_' + idParaExcluir).click();
        }
    }
</script>