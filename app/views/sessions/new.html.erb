<div class="login-wrapper">
  <div class="login-container">
    
    <!-- mensagem de erro -->
    <% if flash.now[:erro] %>
      <div class="error-message" id="mensagem-erro">
        <%= flash.now[:erro] %>
      </div>

      <script>
        setTimeout(function() {
          const mensagem = document.getElementById('mensagem-erro');
          if (mensagem) {
            mensagem.style.transition = 'opacity 0.5s ease';
            mensagem.style.opacity = '0';
            
            setTimeout(function() {
              mensagem.remove();
            }, 500); 
          }
        }, 2000);
      </script>
    <% end %>

    <h1>Log in</h1>
    
    <%= form_with url: login_path do |form| %>
      <div class="input-group">
        <%= image_tag "user.png", alt: "Ícone Usuário" %>
        <%= form.text_field :email, placeholder: "Usuário", required: true %>
      </div>
      
      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :senha, placeholder: "Senha", required: true %>
      </div>
      
      <%= form.submit "Log in", class: "login-button" %>
    <% end %>

   <%= link_to "Esqueceu sua senha?", new_recuperacao_senha_path, class: "forgot-password-link" %>

  </div>
</div>