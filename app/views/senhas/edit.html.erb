<div class="login-wrapper">
  <div class="login-container">
    
     <!-- mensagem de erro -->
    <% if flash.now[:erro] %>
      <div class="error-message" id="mensagem-erro">
        <%= flash.now[:erro] %>
      </div>

      <script>
        setTimeout(function() {
          const mensagem = document.getElementById('mensagem-erro');
          if (mensagem) {
            mensagem.style.transition = 'opacity 0.5s ease';
            mensagem.style.opacity = '0';
            setTimeout(function() { mensagem.remove(); }, 500); 
          }
        }, 2000);
      </script>
    <% end %>

    <h1>Nova Senha</h1>
    <p style="color: #b0c4de; margin-bottom: 25px; font-size: 14px; text-align: center;">
      Para sua segurança, defina uma senha definitiva antes de acessar o sistema.
    </p>
    
    <%= form_with url: redefinir_senha_path, method: :patch do |form| %>
      
      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :senha, placeholder: "Nova senha", required: true %>
      </div>
      
      <div class="input-group">
        <%= image_tag "locked.png", alt: "Ícone Cadeado" %>
        <%= form.password_field :confirmacao_senha, placeholder: "Confirme a nova senha", required: true %>
      </div>
      
      <%= form.submit "Salvar e Entrar", class: "login-button" %>
      
    <% end %>

  </div>
</div>